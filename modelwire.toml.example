# =============================================================================
# ModelWire Configuration Example
#
# Copy this file to modelwire.toml and customize for your deployment.
# All settings have defaults - only override what you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Server configuration
# -----------------------------------------------------------------------------
[server]
# Bind address (default: 127.0.0.1:8787)
# For Docker: bind to 0.0.0.0:8787 or use environment variable
bind = "0.0.0.0:8787"

# Database URL (default: sqlite://modelwire.db)
# For Docker with volume mount: sqlite:///app/data/modelwire.db
database_url = "sqlite:///app/data/modelwire.db"

# Data directory for SQLite and archives
# For Docker: /app/data (mounted from volume)
data_dir = "/app/data"

# Timeouts (defaults are reasonable for most deployments)
# upstream_timeout_secs = 120
# stream_idle_timeout_secs = 60
# max_stream_duration_secs = 1800
# max_body_size = 10485760  # 10 MB

# -----------------------------------------------------------------------------
# Security configuration
# -----------------------------------------------------------------------------
# [security]
# Admin authentication mode: "local_password", "none", or "relay_key"
# admin_auth = "local_password"

# Downstream authentication mode: "relay_key", "passthrough", or "none"
# For public deployments, use "relay_key" with strong keys
# downstream_auth = "relay_key"
#
# IMPORTANT: relay_key mode now requires at least one enabled relay key entry.
# Example:
# [[security.relay_keys]]
# key_hash = "replace-with-hashed-key-prefix"
# enabled = true

# Set to true only if behind a secure network
# allow_passthrough_keys = false

# Set to true for public deployments (enables additional security checks)
# public_deployment = false

# -----------------------------------------------------------------------------
# Provider configuration
# -----------------------------------------------------------------------------
# Add your upstream providers here. Examples:

# Example: OpenAI-compatible provider
# [[providers]]
# id = "openai"
# name = "OpenAI"
# base_url = "https://api.openai.com/v1"
# auth_mode = "pass_authorization"
# default_wire_api = "openai_chat"

# Example: Anthropic provider
# [[providers]]
# id = "anthropic"
# name = "Anthropic"
# base_url = "https://api.anthropic.com"
# auth_mode = "pass_x_api_key"
# default_wire_api = "anthropic"

# Example: Native Responses provider
# [[providers]]
# id = "native-responses"
# name = "Native Responses"
# base_url = "https://api.openai.com/v1"
# auth_mode = "pass_authorization"
# default_wire_api = "responses"

# -----------------------------------------------------------------------------
# Route configuration
# -----------------------------------------------------------------------------
# Map downstream models to upstream providers/targets.

# Example: Route gpt-4o downstream to openai-gpt4o upstream
# [[routes]]
# downstream_model = "gpt-4o"
# description = "GPT-4o via OpenAI"
# enabled = true
# [[routes.targets]]
# provider_id = "openai"
# upstream_model = "gpt-4o"
# priority = 1
# enabled = true

# -----------------------------------------------------------------------------
# Archive configuration (optional)
# -----------------------------------------------------------------------------
# [archive]
# Capture mode: "off", "metadata_only", "visible_only", "full_visible", "debug_raw"
# capture_mode = "off"

# Archive directory (relative to data_dir)
# directory = "archives"
